# PostgreSQL connection string.
# Update host/port/credentials to match your docker-compose setup.
DATABASE_URL=postgres://techradar:techradar_dev@localhost:5432/my_personal_tech_radar

# Google Gemini API key — required for the AI enrichment phase in cmd/worker.
# Get one at https://aistudio.google.com/
# If absent, the worker skips AI enrichment and exits 0 (ingestion still works).
GEMINI_API_KEY=your_gemini_api_key_here
